<?xml version="1.0" encoding="UTF-8"?>
<!-- TigerTech A2 - products schema. The namespace setup is done for you.
     Fill in the TODOs. DJP 10/4/2026-->
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema"
           xmlns:prod="http://tigertech.example/products"
           targetNamespace="http://tigertech.example/products"
           elementFormDefault="qualified">

   <!-- TODO 1: define simpleType skuType - a string matching TT- and 4 digits
        (e.g. TT-1001). -->
   <xs:simpleType name="skuType">
      <xs:restriction base="xs:string">
         <xs:pattern value="TT-[0-9]{4}"/>
      </xs:restriction>
   </xs:simpleType>

   <!-- TODO 2: define simpleType moneyType - a decimal that is >= 0 and has at
        most 2 fraction digits. -->
   <xs:simpleType name="moneyType">
      <xs:restriction base="xs:decimal">
         <xs:minInclusive value="0"/>
         <xs:fractionDigits value="2"/>
      </xs:restriction>
   </xs:simpleType>

   <!-- TODO 3: define simpleType currencyType - a string restricted to the
        values USD, EUR, GBP. -->
   <xs:simpleType name="currencyType">
      <xs:restriction base="xs:string">
         <xs:enumeration value="USD"/>
         <xs:enumeration value="EUR"/>
         <xs:enumeration value="GBP"/>
      </xs:restriction>
   </xs:simpleType>

   <!-- TODO 4: declare the <catalog> root element - a sequence of one or more
        <product> elements. -->
   <xs:element name="catalog">
      <xs:complexType>
         <xs:sequence>
            <xs:element ref="prod:product" maxOccurs="unbounded"/>
         </xs:sequence>
      </xs:complexType>
   </xs:element>

   <!-- TODO 5: declare the <product> element:
          sequence of:
            <name>        string
            <price>       moneyType text WITH a currency attribute of currencyType
            <stock>       a whole number >= 0
            <description> string
          attributes:
            sku       required, type skuType
            category  required, string  (linked to a category in tigertech.xsd) -->
   <xs:element name="product">
      <xs:complexType>
         <xs:sequence>
            <xs:element name="name" type="xs:string"/>
            <xs:element name="price">
               <xs:complexType>
                  <xs:simpleContent>
                     <xs:extension base="prod:moneyType">
                        <xs:attribute name="currency" type="prod:currencyType" use="required"/>
                     </xs:extension>
                  </xs:simpleContent>
               </xs:complexType>
            </xs:element>
            <xs:element name="stock" type="xs:nonNegativeInteger"/>
            <xs:element name="description" type="xs:string"/>
         </xs:sequence>
         <xs:attribute name="sku" type="prod:skuType" use="required"/>
         <xs:attribute name="category" type="xs:string" use="required"/>
      </xs:complexType>
   </xs:element>

</xs:schema>